{
  "version": "1.0.17",
  "themes": [
    "dark",
    "light"
  ],
  "default_theme": "auto",
  "groups": {
    "surfaces": [
      {
        "name": "--df-flavor-default-hue",
        "role": "the surface hue an app opens with — the palette's default swatch (the build checks they match); what clearFlavor() returns to",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "262"
      },
      {
        "name": "--flavor-hue",
        "role": "the live oklch hue of the neutral surfaces; starts at --df-flavor-default-hue and is overwritten by a flavor pick",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "var(--df-flavor-default-hue)"
      },
      {
        "name": "--flavor-on",
        "role": "flavor strength 0..1 — scales surface chroma; 0 is a pure grey base",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "1"
      },
      {
        "name": "--bg-dim",
        "role": "input / table / log wells — the page colour, as on GitHub: the border draws a well",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "oklch(0.176 calc(0.014 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(1 calc(0 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--bg",
        "role": "base app background",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "oklch(0.176 calc(0.014 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(1 calc(0 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--bg-raised",
        "role": "raised card / panel surface",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "oklch(0.22 calc(0.018 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(1 calc(0 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--bg-header",
        "role": "header bar of a raised thing (card, panel, table head); equals the card in dark (the rule under it divides), a pale grey in light",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "oklch(0.22 calc(0.018 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(0.978 calc(0.003 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--bg-hover",
        "role": "hover-state fill (transient only, never a resting surface)",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "oklch(0.292 calc(0.02 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(0.96 calc(0.005 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--df-panel-header-bg",
        "role": "header bar override (.df-card, druid-log-view, druid-subtabs, druid-table)",
        "tags": [
          "theming",
          "surface"
        ]
      },
      {
        "name": "--df-panel-body-bg",
        "role": "panel body override",
        "tags": [
          "theming",
          "surface"
        ]
      },
      {
        "name": "--df-select-bg",
        "role": "select trigger + outline-button background (defaults to --bg)",
        "tags": [
          "theming",
          "surface"
        ]
      },
      {
        "name": "--df-select-pad",
        "role": "druid-select trigger padding (df-shell-compact / [compact] tighten it)",
        "tags": [
          "theming",
          "surface"
        ]
      },
      {
        "name": "--df-select-chev",
        "role": "druid-select chevron size",
        "tags": [
          "theming",
          "surface"
        ]
      },
      {
        "name": "--df-zebra",
        "role": "the alternating wash on a .df-table.zebra row",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "rgba(255, 255, 255, 0.022)",
        "default_light": "rgba(0, 0, 0, 0.022)"
      },
      {
        "name": "--df-navbar-bg",
        "role": "the global header bar: GitHub's inset — darker than the page in dark, the subtle grey in light",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "oklch(0.104 calc(0.019 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(0.978 calc(0.003 * var(--flavor-on)) var(--flavor-hue))"
      }
    ],
    "lines_text": [
      {
        "name": "--border",
        "role": "hairline borders",
        "tags": [
          "theming",
          "text"
        ],
        "default": "oklch(0.384 calc(0.018 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(0.881 calc(0.013 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--border-muted",
        "role": "dividers inside a box (table rows): --border at 70%, so the box outline stays the strongest line",
        "tags": [
          "theming",
          "text"
        ],
        "default": "color-mix(in oklch, var(--border) 70%, transparent)"
      },
      {
        "name": "--border-strong",
        "role": "edges that must read as edges (table rules, sticky header underline)",
        "tags": [
          "theming",
          "text"
        ],
        "default": "oklch(0.529 calc(0.018 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(0.633 calc(0.023 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--text",
        "role": "primary text",
        "tags": [
          "theming",
          "text"
        ],
        "default": "oklch(0.97 calc(0.01 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(0.254 calc(0.011 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--text-muted",
        "role": "secondary / placeholder text",
        "tags": [
          "theming",
          "text"
        ],
        "default": "oklch(0.677 calc(0.016 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(0.495 calc(0.022 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--text-faint",
        "role": "watermarks and disabled glyphs",
        "tags": [
          "theming",
          "text"
        ],
        "default": "oklch(0.529 calc(0.018 * var(--flavor-on)) var(--flavor-hue))",
        "default_light": "oklch(0.633 calc(0.023 * var(--flavor-on)) var(--flavor-hue))"
      },
      {
        "name": "--df-code-bg",
        "role": "the chip behind inline code — a wash of --text-faint, visible on every rung",
        "tags": [
          "theming",
          "text"
        ],
        "default": "color-mix(in oklch, var(--text-faint) 20%, transparent)",
        "default_light": "color-mix(in oklch, var(--text-faint) 12%, transparent)"
      }
    ],
    "accent": [
      {
        "name": "--accent",
        "role": "app accent",
        "tags": [
          "theming",
          "brand",
          "status"
        ],
        "default": "#5b8def"
      },
      {
        "name": "--accent-soft",
        "role": "accent wash (0.18 alpha)",
        "tags": [
          "theming",
          "brand",
          "status"
        ],
        "default": "rgba(91, 141, 239, 0.18)"
      },
      {
        "name": "--df-accent",
        "role": "component accent override (defaults to --accent; df-* classes repoint it)",
        "tags": [
          "theming",
          "brand",
          "status"
        ]
      },
      {
        "name": "--df-accent-soft",
        "role": "component accent wash override",
        "tags": [
          "theming",
          "brand",
          "status"
        ]
      }
    ],
    "status": [
      {
        "name": "--ok",
        "role": "success color",
        "tags": [
          "theming",
          "status"
        ],
        "default": "#3fb950",
        "default_light": "#1a7f37"
      },
      {
        "name": "--ok-soft",
        "role": "success wash",
        "tags": [
          "theming",
          "status"
        ],
        "default": "rgba(46, 160, 67, 0.15)",
        "default_light": "#dafbe1"
      },
      {
        "name": "--warn",
        "role": "warning color",
        "tags": [
          "theming",
          "status"
        ],
        "default": "#d29922",
        "default_light": "#9a6700"
      },
      {
        "name": "--warn-soft",
        "role": "warning wash",
        "tags": [
          "theming",
          "status"
        ],
        "default": "rgba(187, 128, 9, 0.15)",
        "default_light": "#fff8c5"
      },
      {
        "name": "--danger",
        "role": "danger color",
        "tags": [
          "theming",
          "status"
        ],
        "default": "#f85149",
        "default_light": "#d1242f"
      },
      {
        "name": "--danger-soft",
        "role": "danger wash",
        "tags": [
          "theming",
          "status"
        ],
        "default": "rgba(248, 81, 73, 0.1)",
        "default_light": "#ffebe9"
      }
    ],
    "shape": [
      {
        "name": "--df-table-min-width",
        "role": "width floor of a .df-table.wide, and of any table with 5+ columns under 720px, so the wrap scrolls horizontally instead of squeezing (defaults to 620px)",
        "tags": [
          "theming",
          "layout"
        ]
      },
      {
        "name": "--radius",
        "role": "corner radius",
        "tags": [
          "theming",
          "layout"
        ],
        "default": "10px"
      },
      {
        "name": "--radius-sm",
        "role": "tighter radius for dense chrome (inputs, cells, chips)",
        "tags": [
          "theming",
          "layout"
        ],
        "default": "6px"
      },
      {
        "name": "--shadow",
        "role": "elevation shadow",
        "tags": [
          "theming",
          "layout"
        ],
        "default": "0 0 0 1px var(--border), 0 6px 12px -3px rgba(1, 4, 9, 0.4), 0 6px 18px 0 rgba(1, 4, 9, 0.4)",
        "default_light": "0 0 0 1px color-mix(in oklch, var(--border) 25%, transparent), 0 6px 12px -3px rgba(37, 41, 46, 0.04), 0 6px 18px 0 rgba(37, 41, 46, 0.12)"
      },
      {
        "name": "--df-main-pad",
        "role": "padding of the page's <main> (defaults to 30px 22px, 16px 12px under 720px); df-shell-compact sets it to 10px",
        "tags": [
          "theming",
          "layout"
        ]
      },
      {
        "name": "--df-main-max",
        "role": "max width of the page's <main> (defaults to 1100px); df-shell-compact sets none",
        "tags": [
          "theming",
          "layout"
        ]
      },
      {
        "name": "--df-card-shadow",
        "role": "the lift every .df-card casts on top of its border",
        "tags": [
          "theming",
          "layout"
        ],
        "default": "0 1px 1px 0 rgba(1, 4, 9, 0.6), 0 1px 3px 0 rgba(1, 4, 9, 0.6)",
        "default_light": "0 1px 1px 0 rgba(31, 35, 40, 0.04), 0 1px 2px 0 rgba(31, 35, 40, 0.03)"
      },
      {
        "name": "--df-scrim",
        "role": "the dimming behind a modal dialog",
        "tags": [
          "theming",
          "layout"
        ],
        "default": "rgba(33, 40, 48, 0.4)",
        "default_light": "rgba(200, 209, 218, 0.4)"
      }
    ],
    "focus": [
      {
        "name": "--focus-ring",
        "role": "box-shadow halo applied on :focus-visible across light and shadow DOM",
        "tags": [
          "theming",
          "a11y"
        ],
        "default": "0 0 0 3px rgba(var(--accent-rgb), 0.32)"
      },
      {
        "name": "--glow",
        "role": "the same halo as a resting glow for lit elements",
        "tags": [
          "theming",
          "a11y"
        ],
        "default": "0 0 12px rgba(var(--accent-rgb), 0.28)"
      }
    ],
    "motion": [
      {
        "name": "--df-dur-fast",
        "role": "pointer feedback (0.12s)",
        "tags": [
          "theming",
          "motion"
        ],
        "default": "0.12s"
      },
      {
        "name": "--df-dur",
        "role": "standard transition (0.2s)",
        "tags": [
          "theming",
          "motion"
        ],
        "default": "0.2s"
      },
      {
        "name": "--df-dur-slow",
        "role": "entrances and overlays (0.42s)",
        "tags": [
          "theming",
          "motion"
        ],
        "default": "0.42s"
      },
      {
        "name": "--df-ease",
        "role": "shared easing curve — quick out, unhurried settle",
        "tags": [
          "theming",
          "motion"
        ],
        "default": "cubic-bezier(0.22, 0.61, 0.36, 1)"
      },
      {
        "name": "--df-empty-mark",
        "role": "brand leaf as a CSS mask url, published by theme.ts for .df-empty",
        "tags": [
          "theming",
          "motion"
        ]
      }
    ],
    "ladder": [
      {
        "name": "--df-l-dim",
        "role": "oklch lightness of the sunken-well rung — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.176",
        "default_light": "1"
      },
      {
        "name": "--df-c-dim",
        "role": "oklch chroma of the sunken-well rung, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.014",
        "default_light": "0"
      },
      {
        "name": "--df-l-bg",
        "role": "oklch lightness of the page rung — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.176",
        "default_light": "1"
      },
      {
        "name": "--df-c-bg",
        "role": "oklch chroma of the page rung, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.014",
        "default_light": "0"
      },
      {
        "name": "--df-l-raised",
        "role": "oklch lightness of the raised card/panel rung — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.22",
        "default_light": "1"
      },
      {
        "name": "--df-c-raised",
        "role": "oklch chroma of the raised card/panel rung, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.018",
        "default_light": "0"
      },
      {
        "name": "--df-l-header",
        "role": "oklch lightness of the header-bar rung — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.22",
        "default_light": "0.978"
      },
      {
        "name": "--df-c-header",
        "role": "oklch chroma of the header-bar rung, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.018",
        "default_light": "0.003"
      },
      {
        "name": "--df-l-hover",
        "role": "oklch lightness of the pointer-feedback rung — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.292",
        "default_light": "0.96"
      },
      {
        "name": "--df-c-hover",
        "role": "oklch chroma of the pointer-feedback rung, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.02",
        "default_light": "0.005"
      },
      {
        "name": "--df-l-border",
        "role": "oklch lightness of the default line — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.384",
        "default_light": "0.881"
      },
      {
        "name": "--df-c-border",
        "role": "oklch chroma of the default line, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.018",
        "default_light": "0.013"
      },
      {
        "name": "--df-l-border-strong",
        "role": "oklch lightness of the line that must read as an edge — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.529",
        "default_light": "0.633"
      },
      {
        "name": "--df-c-border-strong",
        "role": "oklch chroma of the line that must read as an edge, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.018",
        "default_light": "0.023"
      },
      {
        "name": "--df-l-text",
        "role": "oklch lightness of body text — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.97",
        "default_light": "0.254"
      },
      {
        "name": "--df-c-text",
        "role": "oklch chroma of body text, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.01",
        "default_light": "0.011"
      },
      {
        "name": "--df-l-text-muted",
        "role": "oklch lightness of secondary text — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.677",
        "default_light": "0.495"
      },
      {
        "name": "--df-c-text-muted",
        "role": "oklch chroma of secondary text, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.016",
        "default_light": "0.022"
      },
      {
        "name": "--df-l-text-faint",
        "role": "oklch lightness of watermarks and disabled glyphs — the per-theme scalar the ladder formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.529",
        "default_light": "0.633"
      },
      {
        "name": "--df-c-text-faint",
        "role": "oklch chroma of watermarks and disabled glyphs, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.018",
        "default_light": "0.023"
      },
      {
        "name": "--df-l-nav",
        "role": "oklch lightness of the navbar rung (--df-navbar-bg) — the per-theme scalar the formula reads",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.104",
        "default_light": "0.978"
      },
      {
        "name": "--df-c-nav",
        "role": "oklch chroma of the navbar rung, before --flavor-on scales it",
        "tags": [
          "theming",
          "surface"
        ],
        "default": "0.019",
        "default_light": "0.003"
      }
    ]
  }
}
