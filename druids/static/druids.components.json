      ],
      "consumes_css_vars": [
        {
          "var": "--bg-raised",
          "affects": "panel background"
        },
        {
          "var": "--df-accent",
          "affects": "panel border color (override for a quiet-at-rest / accent-when-open trigger)"
        },
